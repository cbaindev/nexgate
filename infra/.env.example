# Valores para desarrollo local. NO usar en ningún entorno compartido.
# POSTGRES_USER es el superusuario del contenedor: solo para administración, nunca para la aplicación.
POSTGRES_USER=nexgate
POSTGRES_PASSWORD=nexgate_dev
POSTGRES_DB=nexgate
POSTGRES_PORT=5432
# Roles de Nexgate (los crea infra/postgres/init/01-roles.sh al inicializar el volumen).
NEXGATE_OWNER_PASSWORD=nexgate_owner_dev
NEXGATE_APP_PASSWORD=nexgate_app_dev
MQTT_PORT=1883
