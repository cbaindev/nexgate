{
  "name": "nexgate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPA progresiva de Nexgate (D-29): panel con vistas por rol que consume la API REST con un cliente generado del contrato (D-34).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node scripts/api.mjs generate",
    "api:check": "node scripts/api.mjs check",
    "check": "npm run api:check && npm run typecheck && npm run lint && npm run test && vite build && node scripts/check-pwa.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@tanstack/react-query": "5.80.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "25.2.1",
    "lucide-react": "0.515.0",
    "openapi-fetch": "0.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "15.5.3",
    "react-router": "7.6.2",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@tailwindcss/vite": "4.1.10",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "msw": "2.10.2",
    "openapi-typescript": "7.8.0",
    "sharp": "0.34.2",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.2.4"
  }
}
