<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AV0029/AV0030 sugieren un documento OpenAPI por versión con Asp.Versioning.OpenApi. Hoy hay una sola versión y su
    documento es el contrato versionado (api/nexgate-v1.openapi.json, D-34), generado con transformadores propios; se
    revisa cuando llegue la v2.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\06.Common\Nexgate.Common.BuildingBlocks\Nexgate.Common.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Identity.Contracts\Nexgate.Service.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Identity\Nexgate.Service.Identity.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Tenancy.Contracts\Nexgate.Service.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Tenancy\Nexgate.Service.Tenancy.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Spaces.Contracts\Nexgate.Service.Spaces.Contracts.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Spaces\Nexgate.Service.Spaces.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Occupancy.Contracts\Nexgate.Service.Occupancy.Contracts.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Occupancy\Nexgate.Service.Occupancy.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Access.Contracts\Nexgate.Service.Access.Contracts.csproj" />
    <ProjectReference Include="..\..\03.Service\Nexgate.Service.Access\Nexgate.Service.Access.csproj" />
  </ItemGroup>

</Project>
